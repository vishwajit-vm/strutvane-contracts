{
  "name": "@strutvane/contracts",
  "version": "0.1.0-next.0",
  "description": "Shared TypeScript types and wire protocols for the Strutvane ecosystem. Zero runtime dependencies.",
  "keywords": [
    "strutvane",
    "typescript",
    "types",
    "contracts",
    "rbac",
    "multi-tenancy",
    "openapi"
  ],
  "homepage": "https://github.com/vishwajit-vm/strutvane-contracts#readme",
  "bugs": {
    "url": "https://github.com/vishwajit-vm/strutvane-contracts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwajit-vm/strutvane-contracts.git"
  },
  "license": "MIT",
  "author": "The Strutvane Authors",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "ci": "biome check . && tsc --noEmit && vitest run --coverage && tsdown",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@vitest/coverage-v8": "5.1.0",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
